<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DevDeploy — Cloud Deployment Platform</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&display=swap"
        rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = { theme: { extend: { fontFamily: { poppins: ['Poppins', 'sans-serif'] }, colors: { brand: { purple: '#6a11cb', pink: '#ff4ecd', violet: '#8b5cf6', teal: '#0d9488', mint: '#10b981' } } } } }
    </script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: #0a0a1a;
            color: #fff;
            overflow-x: hidden
        }

        .gradient-text {
            background: linear-gradient(135deg, #a78bfa, #ff4ecd);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent
        }

        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            opacity: .4;
            pointer-events: none
        }

        .glass {
            background: rgba(255, 255, 255, .06);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, .1)
        }

        .reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: all .7s cubic-bezier(.22, 1, .36, 1)
        }

        .reveal.visible {
            opacity: 1;
            transform: translateY(0)
        }

        .feature-card {
            transition: all .4s cubic-bezier(.22, 1, .36, 1)
        }

        .feature-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 25px 60px rgba(106, 17, 203, .15)
        }

        .btn-shine {
            position: relative;
            overflow: hidden
        }

        .btn-shine::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(to right, transparent, rgba(255, 255, 255, .15), transparent);
            transform: rotate(30deg);
            transition: all .6s;
            opacity: 0
        }

        .btn-shine:hover::after {
            opacity: 1;
            left: 100%
        }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            display: inline-block
        }

        .status-live {
            background: #10b981;
            box-shadow: 0 0 6px #10b981
        }

        .status-deploying {
            background: #f59e0b;
            box-shadow: 0 0 6px #f59e0b
        }

        .status-failed {
            background: #ef4444;
            box-shadow: 0 0 6px #ef4444
        }

        .drop-active {
            border-color: #6a11cb !important;
            background: rgba(106, 17, 203, .06) !important
        }

        .progress-bar {
            transition: width .3s ease
        }

        .section {
            display: none
        }

        .section.active {
            display: block
        }

        #toast {
            position: fixed;
            top: 24px;
            right: 24px;
            z-index: 99;
            padding: 12px 20px;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 500;
            transform: translateX(140%);
            transition: transform .4s ease;
            max-width: 360px
        }

        #toast.show {
            transform: translateX(0)
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px)
            }

            to {
                opacity: 1;
                transform: translateY(0)
            }
        }

        .fade-in {
            animation: fadeIn .4s ease
        }

        @keyframes float {

            0%,
            100% {
                transform: translateY(0)
            }

            50% {
                transform: translateY(-20px)
            }
        }

        .animate-float {
            animation: float 6s ease-in-out infinite
        }

        .hero-waves {
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 100%;
            z-index: 1
        }

        .hero-waves svg {
            display: block;
            width: 100%;
            height: auto
        }

        table tr:hover {
            background: rgba(106, 17, 203, .03)
        }
    </style>
</head>

<body class="font-poppins antialiased">
    <div id="toast"></div>

    <!-- ╔══════════════════════════════════════╗ -->
    <!-- ║     SECTION: LANDING PAGE           ║ -->
    <!-- ╚══════════════════════════════════════╝ -->
    <div id="landingSection" class="section active">
        <!-- Nav -->
        <nav id="landingNav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500">
            <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
                <a href="#" class="flex items-center gap-2 text-xl font-bold">
                    <span
                        class="w-9 h-9 rounded-xl bg-gradient-to-br from-brand-purple to-brand-pink flex items-center justify-center text-sm shadow-lg shadow-purple-500/30">🚀</span>
                    <span class="gradient-text">DevDeploy</span>
                </a>
                <div class="hidden md:flex items-center gap-8">
                    <a href="#features"
                        class="text-sm text-gray-300 hover:text-white transition font-medium">Features</a>
                    <a href="#how-it-works" class="text-sm text-gray-300 hover:text-white transition font-medium">How It
                        Works</a>
                </div>
                <div class="flex items-center gap-3">
                    <a href="#" onclick="navigate('login'); return false;"
                        class="text-sm text-gray-300 hover:text-white transition font-medium hidden md:block">Log In</a>
                    <a href="#" onclick="navigate('register'); return false;"
                        class="px-5 py-2 rounded-full bg-gradient-to-r from-brand-teal to-brand-mint text-white text-sm font-semibold shadow-lg shadow-teal-500/30 hover:shadow-teal-500/50 hover:scale-105 transition-all duration-300">Sign
                        Up Free</a>
                </div>
            </div>
        </nav>

        <!-- Hero -->
        <section class="relative min-h-screen flex flex-col items-center justify-start pt-32 pb-16 overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-[#0d0028] via-[#1a0040] to-[#0d0028]"></div>
            <div class="orb w-[600px] h-[600px] bg-brand-purple top-[-100px] left-[-200px] animate-float"></div>
            <div class="orb w-[500px] h-[500px] bg-brand-pink top-[50px] right-[-150px]"
                style="animation:float 6s ease-in-out 2s infinite"></div>
            <div class="orb w-[400px] h-[400px] bg-brand-violet bottom-[100px] left-[30%]"
                style="animation:float 8s ease-in-out 1s infinite"></div>

            <div class="relative z-10 text-center max-w-4xl mx-auto px-6">
                <div class="mb-6"><span
                        class="inline-flex items-center gap-2 px-5 py-2 rounded-full glass text-sm font-medium text-purple-200 border border-purple-400/30"><span
                            class="w-2 h-2 bg-brand-mint rounded-full animate-pulse"></span>Cloud Deployment
                        Platform</span></div>
                <h1 class="text-5xl sm:text-6xl lg:text-7xl font-extrabold leading-tight tracking-tight">Deploy your
                    projects<br><span class="gradient-text">instantly with one click</span></h1>
                <p class="mt-6 text-lg sm:text-xl text-gray-300/90 max-w-2xl mx-auto leading-relaxed font-light">Fast,
                    scalable cloud deployments for modern developers. Upload your ZIP, connect your repo, and go live in
                    seconds.</p>
                <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
                    <a href="#" onclick="navigate('login'); return false;"
                        class="btn-shine group px-8 py-4 rounded-2xl bg-gradient-to-r from-brand-teal to-emerald-500 text-white font-semibold text-base shadow-xl shadow-teal-600/30 hover:shadow-teal-500/50 hover:scale-105 transition-all duration-300 flex items-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                        </svg>
                        Upload Project
                    </a>
                    <a href="#" onclick="navigate('login'); return false;"
                        class="group px-8 py-4 rounded-2xl border border-white/20 text-white font-semibold text-base hover:bg-white/10 transition-all duration-300 flex items-center gap-2">View
                        Projects</a>
                </div>
            </div>
            <div class="hero-waves"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 180"
                    preserveAspectRatio="none">
                    <path fill="#0a0a1a"
                        d="M0,130 C360,170 720,90 1080,140 C1260,160 1380,120 1440,130 L1440,180 L0,180 Z" />
                </svg></div>
        </section>

        <!-- Features -->
        <section id="features" class="relative py-24 px-6">
            <div class="max-w-6xl mx-auto">
                <div class="text-center mb-16 reveal">
                    <h2 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-4">Everything you need to <span
                            class="gradient-text">ship fast</span></h2>
                    <p class="text-gray-400 max-w-xl mx-auto text-lg font-light">From upload to live URL in seconds.</p>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                    <div class="feature-card reveal bg-white/[.04] border border-white/[.08] rounded-2xl p-6 group"
                        style="transition-delay:.1s">
                        <div
                            class="w-14 h-14 rounded-2xl bg-gradient-to-br from-brand-teal/20 to-emerald-500/20 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
                            <svg class="w-7 h-7 text-brand-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M13 10V3L4 14h7v7l9-11h-7z" />
                            </svg></div>
                        <h3 class="text-lg font-bold mb-2">One-click Deploy</h3>
                        <p class="text-gray-400 text-sm leading-relaxed">Upload your ZIP and go live instantly. No
                            complex CI/CD pipelines.</p>
                    </div>
                    <div class="feature-card reveal bg-white/[.04] border border-white/[.08] rounded-2xl p-6 group"
                        style="transition-delay:.2s">
                        <div
                            class="w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-500/20 to-cyan-400/20 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
                            <svg class="w-7 h-7 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                            </svg></div>
                        <h3 class="text-lg font-bold mb-2">Live Project URL</h3>
                        <p class="text-gray-400 text-sm leading-relaxed">Every deployment gets a unique live URL. Share
                            instantly.</p>
                    </div>
                    <div class="feature-card reveal bg-white/[.04] border border-white/[.08] rounded-2xl p-6 group"
                        style="transition-delay:.3s">
                        <div
                            class="w-14 h-14 rounded-2xl bg-gradient-to-br from-brand-purple/20 to-brand-pink/20 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
                            <svg class="w-7 h-7 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                            </svg></div>
                        <h3 class="text-lg font-bold mb-2">JWT Authentication</h3>
                        <p class="text-gray-400 text-sm leading-relaxed">Built-in auth with enterprise-grade security
                            tokens.</p>
                    </div>
                    <div class="feature-card reveal bg-white/[.04] border border-white/[.08] rounded-2xl p-6 group"
                        style="transition-delay:.4s">
                        <div
                            class="w-14 h-14 rounded-2xl bg-gradient-to-br from-amber-500/20 to-orange-400/20 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
                            <svg class="w-7 h-7 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                            </svg></div>
                        <h3 class="text-lg font-bold mb-2">Full Dashboard</h3>
                        <p class="text-gray-400 text-sm leading-relaxed">Manage, monitor, and delete projects with
                            real-time stats.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- How It Works -->
        <section id="how-it-works" class="relative py-24 px-6">
            <div class="max-w-5xl mx-auto">
                <div class="text-center mb-16 reveal">
                    <h2 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-4">Deploy in <span
                            class="gradient-text">three steps</span></h2>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div class="reveal text-center group" style="transition-delay:.1s">
                        <div
                            class="w-20 h-20 mx-auto rounded-3xl bg-gradient-to-br from-brand-purple to-brand-pink flex items-center justify-center text-2xl font-black text-white shadow-xl shadow-purple-500/25 mb-6 group-hover:scale-110 transition-all">
                            1</div>
                        <h3 class="text-xl font-bold mb-2">Upload ZIP</h3>
                        <p class="text-gray-400 text-sm">Drag & drop your project archive up to 500 MB.</p>
                    </div>
                    <div class="reveal text-center group" style="transition-delay:.25s">
                        <div
                            class="w-20 h-20 mx-auto rounded-3xl bg-gradient-to-br from-brand-teal to-emerald-500 flex items-center justify-center text-2xl font-black text-white shadow-xl shadow-teal-500/25 mb-6 group-hover:scale-110 transition-all">
                            2</div>
                        <h3 class="text-xl font-bold mb-2">Auto Build</h3>
                        <p class="text-gray-400 text-sm">We detect framework, install deps, and build automatically.</p>
                    </div>
                    <div class="reveal text-center group" style="transition-delay:.4s">
                        <div
                            class="w-20 h-20 mx-auto rounded-3xl bg-gradient-to-br from-blue-500 to-cyan-400 flex items-center justify-center text-2xl font-black text-white shadow-xl shadow-blue-500/25 mb-6 group-hover:scale-110 transition-all">
                            3</div>
                        <h3 class="text-xl font-bold mb-2">Go Live</h3>
                        <p class="text-gray-400 text-sm">Your project is live with a unique URL instantly.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA -->
        <section class="relative py-24 px-6 overflow-hidden">
            <div
                class="absolute inset-0 bg-gradient-to-br from-brand-purple/20 via-brand-pink/10 to-transparent pointer-events-none">
            </div>
            <div class="max-w-3xl mx-auto text-center relative z-10 reveal">
                <h2 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-6">Ready to <span
                        class="gradient-text">launch</span>?</h2>
                <p class="text-gray-400 text-lg mb-10 font-light">Start deploying in under 30 seconds — completely free.
                </p>
                <a href="#" onclick="navigate('register'); return false;"
                    class="btn-shine inline-flex items-center gap-2 px-10 py-4 rounded-2xl bg-gradient-to-r from-brand-teal to-emerald-500 text-white font-semibold shadow-xl shadow-teal-600/30 hover:scale-105 transition-all duration-300">Get
                    Started Free <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg></a>
            </div>
        </section>

        <!-- Footer -->
        <footer class="border-t border-white/[.06] py-12 px-6">
            <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
                <div class="flex items-center gap-2"><span
                        class="w-8 h-8 rounded-xl bg-gradient-to-br from-brand-purple to-brand-pink flex items-center justify-center text-xs shadow-md">🚀</span><span
                        class="font-bold text-lg gradient-text">DevDeploy</span></div>
                <div class="flex items-center gap-8 text-sm text-gray-500">
                    <a href="#features" class="hover:text-white transition">Features</a>
                    <a href="#" onclick="navigate('login'); return false;" class="hover:text-white transition">Login</a>
                    <a href="#" onclick="navigate('register'); return false;" class="hover:text-white transition">Sign
                        Up</a>
                </div>
                <p class="text-xs text-gray-600">&copy; 2026 DevDeploy.</p>
            </div>
        </footer>
    </div>

    <!-- ╔══════════════════════════════════════╗ -->
    <!-- ║     SECTION: LOGIN                  ║ -->
    <!-- ╚══════════════════════════════════════╝ -->
    <div id="loginSection" class="section min-h-screen flex items-center justify-center px-4 relative"
        style="background:#0a0a1a">
        <div class="orb w-[500px] h-[500px] bg-brand-purple -top-40 -left-40 absolute"></div>
        <div class="orb w-[400px] h-[400px] bg-brand-pink -bottom-32 -right-32 absolute"></div>
        <div class="w-full max-w-md glass rounded-3xl p-8 relative z-10">
            <div class="text-center mb-8">
                <a href="#" onclick="navigate('landing'); return false;"
                    class="inline-flex items-center gap-2.5 text-2xl font-bold mb-6 hover:opacity-80 transition"><span
                        class="w-11 h-11 rounded-xl bg-gradient-to-br from-brand-purple to-brand-pink flex items-center justify-center text-base shadow-lg shadow-purple-500/30">🚀</span><span
                        class="gradient-text">DevDeploy</span></a>
                <h1 class="text-2xl font-bold mt-2">Welcome Back</h1>
                <p class="text-gray-400 text-sm mt-1">Sign in to manage your deployments</p>
            </div>
            <form id="loginForm" class="space-y-5">
                <div><label class="block text-sm font-medium text-gray-300 mb-1.5">Username</label><input type="text"
                        id="loginUser" placeholder="Enter username" required
                        class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-brand-purple focus:ring-2 focus:ring-brand-purple/30 transition">
                </div>
                <div><label class="block text-sm font-medium text-gray-300 mb-1.5">Password</label><input
                        type="password" id="loginPass" placeholder="••••••••" required
                        class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-brand-purple focus:ring-2 focus:ring-brand-purple/30 transition">
                </div>
                <button type="submit" id="loginBtn"
                    class="w-full py-3.5 rounded-xl bg-gradient-to-r from-brand-purple to-brand-pink text-white font-semibold hover:opacity-90 hover:shadow-lg hover:shadow-purple-500/25 transition-all">Sign
                    In</button>
            </form>
            <p class="text-center mt-6 text-sm text-gray-400">Don't have an account? <a href="#"
                    onclick="navigate('register'); return false;"
                    class="text-purple-400 font-semibold hover:text-purple-300 ml-1">Create one</a></p>
        </div>
    </div>

    <!-- ╔══════════════════════════════════════╗ -->
    <!-- ║     SECTION: REGISTER               ║ -->
    <!-- ╚══════════════════════════════════════╝ -->
    <div id="registerSection" class="section min-h-screen flex items-center justify-center px-4 relative"
        style="background:#0a0a1a">
        <div class="orb w-[500px] h-[500px] bg-brand-pink -top-40 -right-40 absolute"></div>
        <div class="orb w-[400px] h-[400px] bg-brand-purple -bottom-32 -left-32 absolute"></div>
        <div class="w-full max-w-md glass rounded-3xl p-8 relative z-10">
            <div class="text-center mb-8">
                <a href="#" onclick="navigate('landing'); return false;"
                    class="inline-flex items-center gap-2.5 text-2xl font-bold mb-6 hover:opacity-80 transition"><span
                        class="w-11 h-11 rounded-xl bg-gradient-to-br from-brand-purple to-brand-pink flex items-center justify-center text-base shadow-lg shadow-purple-500/30">🚀</span><span
                        class="gradient-text">DevDeploy</span></a>
                <h1 class="text-2xl font-bold mt-2">Create Account</h1>
                <p class="text-gray-400 text-sm mt-1">Start deploying in under 30 seconds</p>
            </div>
            <form id="registerForm" class="space-y-5">
                <div><label class="block text-sm font-medium text-gray-300 mb-1.5">Username</label><input type="text"
                        id="regUser" placeholder="Choose a username" required minlength="3"
                        class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-brand-purple focus:ring-2 focus:ring-brand-purple/30 transition">
                </div>
                <div><label class="block text-sm font-medium text-gray-300 mb-1.5">Password</label><input
                        type="password" id="regPass" placeholder="Min 6 characters" required minlength="6"
                        class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-brand-purple focus:ring-2 focus:ring-brand-purple/30 transition">
                </div>
                <button type="submit" id="regBtn"
                    class="w-full py-3.5 rounded-xl bg-gradient-to-r from-brand-teal to-brand-mint text-white font-semibold hover:opacity-90 hover:shadow-lg hover:shadow-teal-500/25 transition-all">Create
                    Account</button>
            </form>
            <p class="text-center mt-6 text-sm text-gray-400">Already have an account? <a href="#"
                    onclick="navigate('login'); return false;"
                    class="text-purple-400 font-semibold hover:text-purple-300 ml-1">Sign in</a></p>
        </div>
    </div>

    <!-- ╔══════════════════════════════════════╗ -->
    <!-- ║     SECTION: DASHBOARD              ║ -->
    <!-- ╚══════════════════════════════════════╝ -->
    <div id="dashboardSection" class="section" style="background:#f3f0ff;min-height:100vh">
        <!-- Purple Nav -->
        <nav
            class="sticky top-0 z-40 bg-gradient-to-r from-[#1a0040] via-[#2d1065] to-[#1a0040] shadow-lg shadow-purple-900/20">
            <div class="max-w-6xl mx-auto px-6 py-3 flex items-center justify-between">
                <a href="#" onclick="navigate('landing'); return false;"
                    class="flex items-center gap-2 text-base font-bold text-white">🚀 DevDeploy</a>
                <div class="hidden sm:flex items-center gap-6 text-sm font-medium">
                    <a href="#" class="text-white/90 hover:text-white transition flex items-center gap-1.5"><svg
                            class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                        </svg>Dashboard</a>
                    <a href="#" class="text-purple-200/70 hover:text-white transition flex items-center gap-1.5"><svg
                            class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                        </svg>Projects</a>
                    <a href="#" class="text-purple-200/70 hover:text-white transition flex items-center gap-1.5"><svg
                            class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                        </svg>Upload</a>
                    <a href="#" onclick="doLogout(); return false;"
                        class="text-purple-200/70 hover:text-white transition flex items-center gap-1.5 cursor-pointer"><svg
                            class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                        </svg>Logout</a>
                </div>
                <div class="w-8 h-8 rounded-full bg-gradient-to-br from-brand-teal to-brand-mint flex items-center justify-center text-xs font-bold text-white shadow-md"
                    id="dashAvatar">A</div>
            </div>
        </nav>

        <div class="max-w-6xl mx-auto px-6 py-8">
            <!-- Stats -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
                <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
                    <p class="text-[10px] font-semibold text-gray-400 uppercase tracking-wider mb-1">Total Projects</p>
                    <p id="statTotal" class="text-3xl font-bold text-gray-900">—</p>
                </div>
                <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
                    <p class="text-[10px] font-semibold text-gray-400 uppercase tracking-wider mb-1">Live Now</p>
                    <p id="statLive" class="text-3xl font-bold text-emerald-600">—</p>
                </div>
                <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
                    <p class="text-[10px] font-semibold text-gray-400 uppercase tracking-wider mb-1">Bandwidth</p>
                    <p id="statBW" class="text-3xl font-bold text-brand-purple">—</p>
                </div>
            </div>

            <!-- Projects Table -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden mb-8">
                <div class="px-5 py-4 border-b border-gray-100 flex items-center justify-between">
                    <h3 class="text-sm font-bold text-gray-800 flex items-center gap-2"><svg
                            class="w-4 h-4 text-brand-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                        </svg>Active Deployments</h3>
                    <div class="flex items-center gap-3"><span id="projCount"
                            class="text-[10px] bg-purple-100 text-brand-purple px-2.5 py-1 rounded-full font-semibold">0</span><button
                            onclick="fetchProjects()" class="text-xs text-gray-400 hover:text-brand-purple transition">↻
                            Refresh</button></div>
                </div>
                <table class="w-full text-sm" id="projTable">
                    <thead>
                        <tr
                            class="text-left text-[11px] uppercase tracking-wider text-gray-400 border-b border-gray-50">
                            <th class="px-5 py-3 font-semibold">Project</th>
                            <th class="px-5 py-3 font-semibold">Status</th>
                            <th class="px-5 py-3 font-semibold hidden md:table-cell">URL</th>
                            <th class="px-5 py-3 font-semibold text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody id="projBody"></tbody>
                </table>
                <div id="emptyState" class="hidden text-center py-12">
                    <div class="text-4xl mb-3">📦</div>
                    <p class="text-gray-500 font-medium">No deployments yet</p>
                    <p class="text-gray-400 text-xs mt-1">Upload a project below!</p>
                </div>
                <div id="loadState" class="hidden text-center py-10">
                    <div
                        class="w-6 h-6 border-2 border-brand-purple border-t-transparent rounded-full animate-spin mx-auto mb-2">
                    </div>
                    <p class="text-gray-400 text-sm">Loading...</p>
                </div>
            </div>

            <!-- Upload -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="px-5 py-4 border-b border-gray-100">
                    <h3 class="text-sm font-bold text-gray-800 flex items-center gap-2"><svg
                            class="w-4 h-4 text-brand-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                        </svg>Deploy New Project</h3>
                </div>
                <div class="p-5">
                    <form id="deployForm" class="space-y-4">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div><label
                                    class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5">Project
                                    Name *</label><input type="text" id="projName" placeholder="my-awesome-site"
                                    required
                                    class="w-full px-4 py-2.5 rounded-xl bg-gray-50 border border-gray-200 text-gray-800 placeholder-gray-400 text-sm focus:outline-none focus:border-brand-purple focus:ring-2 focus:ring-brand-purple/20 transition">
                            </div>
                            <div><label
                                    class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5">GitHub
                                    URL <span class="text-gray-300">(optional)</span></label><input type="url"
                                    id="ghUrl" placeholder="https://github.com/user/repo"
                                    class="w-full px-4 py-2.5 rounded-xl bg-gray-50 border border-gray-200 text-gray-800 placeholder-gray-400 text-sm focus:outline-none focus:border-brand-purple focus:ring-2 focus:ring-brand-purple/20 transition">
                            </div>
                        </div>
                        <div id="dropZone"
                            class="border-2 border-dashed border-purple-200 rounded-2xl p-6 text-center cursor-pointer hover:border-brand-purple hover:bg-purple-50/30 transition-all group">
                            <input type="file" id="fileInput" accept=".zip" class="hidden">
                            <div
                                class="w-12 h-12 mx-auto rounded-2xl bg-gradient-to-br from-brand-purple/10 to-brand-pink/10 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
                                <svg class="w-6 h-6 text-brand-purple" fill="none" stroke="currentColor"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                                </svg></div>
                            <p id="fileLabel" class="text-sm font-semibold text-gray-700">Drop your project ZIP here or
                                <span class="text-brand-purple">browse</span></p>
                            <p class="text-xs text-gray-400 mt-1">Max 500 MB</p>
                        </div>
                        <div id="progWrap" class="hidden">
                            <div class="flex items-center justify-between mb-1"><span
                                    class="text-xs text-gray-500">Uploading...</span><span id="progText"
                                    class="text-xs text-brand-purple font-mono font-bold">0%</span></div>
                            <div class="w-full bg-gray-100 rounded-full h-2 overflow-hidden">
                                <div id="progBar"
                                    class="progress-bar h-full bg-gradient-to-r from-brand-purple to-brand-pink rounded-full"
                                    style="width:0%"></div>
                            </div>
                        </div>
                        <button type="submit" id="deployBtn"
                            class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-brand-teal to-emerald-500 text-white font-semibold text-sm hover:opacity-90 hover:shadow-lg hover:shadow-teal-500/20 transition-all flex items-center gap-2">🚀
                            Deploy Now</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- ╔══════════════════════════════════════╗ -->
    <!-- ║     JAVASCRIPT                      ║ -->
    <!-- ╚══════════════════════════════════════╝ -->
    <script>
        const API = '/api';
        let token = localStorage.getItem('token'), username = localStorage.getItem('username');

        /* ── Show one section, hide all others ── */
        function showSection(id) {
            document.querySelectorAll('.section').forEach(s => { s.style.display = 'none'; s.classList.remove('active'); });
            const el = document.getElementById(id);
            if (el) { el.style.display = 'block'; el.classList.add('active'); }
        }

        /* ── Navigate ── */
        function navigate(page, pushState) {
            window.scrollTo(0, 0);
            if (page === 'landing') { showSection('landingSection'); document.body.style.background = '#0a0a1a'; initReveal(); }
            else if (page === 'login') { showSection('loginSection'); document.body.style.background = '#0a0a1a'; }
            else if (page === 'register') { showSection('registerSection'); document.body.style.background = '#0a0a1a'; }
            else if (page === 'dashboard') {
                if (!token) { navigate('login', true); return; }
                showSection('dashboardSection');
                document.body.style.background = '#f3f0ff';
                document.getElementById('dashAvatar').textContent = (username || 'U')[0].toUpperCase();
                fetchProjects();
            }
            if (pushState !== false) history.pushState({ page: page }, '', '#' + page);
        }

        /* ── Init ── */
        function init() {
            setupEvents();
            const hash = location.hash.replace('#', '').replace('/', '');
            // Decide what to show first
            if (hash === 'dashboard' && token) { navigate('dashboard'); }
            else if (hash === 'login') { navigate('login'); }
            else if (hash === 'register') { navigate('register'); }
            else if (token && (hash === '' || hash === 'landing')) { navigate('landing'); }
            else { navigate('landing'); }
            initReveal();
        }

        function initReveal() { document.querySelectorAll('.reveal').forEach(el => { const obs = new IntersectionObserver(e => { e.forEach(en => { if (en.isIntersecting) { en.target.classList.add('visible'); obs.unobserve(en.target); } }) }, { threshold: .1 }); obs.observe(el); }); }

        function setupEvents() {
            // Login
            document.getElementById('loginForm').onsubmit = async e => {
                e.preventDefault();
                const btn = document.getElementById('loginBtn'), u = document.getElementById('loginUser').value.trim(), p = document.getElementById('loginPass').value;
                if (!u || !p) return toast('Fill in all fields', 'error');
                btn.disabled = true; btn.textContent = 'Signing in...';
                try {
                    const r = await fetch(API + '/auth/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ username: u, password: p }) });
                    const d = await r.json();
                    if (r.ok && d.token) { localStorage.setItem('token', d.token); localStorage.setItem('username', d.user.username); token = d.token; username = d.user.username; toast('✅ Login successful!', 'success'); setTimeout(() => navigate('dashboard'), 600); }
                    else toast(d.msg || 'Invalid credentials', 'error');
                } catch (err) { console.error(err); toast('Server unreachable', 'error'); }
                finally { btn.disabled = false; btn.textContent = 'Sign In'; }
            };

            // Register
            document.getElementById('registerForm').onsubmit = async e => {
                e.preventDefault();
                const btn = document.getElementById('regBtn'), u = document.getElementById('regUser').value.trim(), p = document.getElementById('regPass').value;
                if (!u || !p) return toast('Fill in all fields', 'error');
                btn.disabled = true; btn.textContent = 'Creating...';
                try {
                    const r = await fetch(API + '/auth/signup', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ username: u, password: p }) });
                    const d = await r.json();
                    if (r.ok && d.token) { localStorage.setItem('token', d.token); localStorage.setItem('username', d.user.username); token = d.token; username = d.user.username; toast('✅ Account created!', 'success'); setTimeout(() => navigate('dashboard'), 600); }
                    else toast(d.msg || 'Registration failed', 'error');
                } catch (err) { console.error(err); toast('Server unreachable', 'error'); }
                finally { btn.disabled = false; btn.textContent = 'Create Account'; }
            };

            // File drop
            const dz = document.getElementById('dropZone'), fi = document.getElementById('fileInput');
            dz.onclick = () => fi.click();
            fi.onchange = () => { if (fi.files[0]) document.getElementById('fileLabel').innerHTML = 'Selected: <span class="text-emerald-600 font-bold">' + fi.files[0].name + '</span>'; };
            dz.ondragover = e => { e.preventDefault(); dz.classList.add('drop-active'); };
            dz.ondragleave = () => dz.classList.remove('drop-active');
            dz.ondrop = e => { e.preventDefault(); dz.classList.remove('drop-active'); if (e.dataTransfer.files.length) { fi.files = e.dataTransfer.files; fi.dispatchEvent(new Event('change')); } };

            // Deploy
            document.getElementById('deployForm').onsubmit = e => {
                e.preventDefault();
                const name = document.getElementById('projName').value.trim(), gh = document.getElementById('ghUrl').value.trim(), file = fi.files[0];
                if (!name) return toast('Project name required', 'error');
                if (!file) return toast('Select a ZIP file', 'error');
                const btn = document.getElementById('deployBtn'), pw = document.getElementById('progWrap'), pb = document.getElementById('progBar'), pt = document.getElementById('progText');
                btn.disabled = true; btn.innerHTML = '⏳ Deploying...'; pw.classList.remove('hidden');
                const fd = new FormData(); fd.append('projectName', name); fd.append('githubUrl', gh); fd.append('projectFile', file);
                const xhr = new XMLHttpRequest();
                xhr.open('POST', API + '/deploy'); xhr.setRequestHeader('Authorization', 'Bearer ' + token);
                xhr.upload.onprogress = e => { if (e.lengthComputable) { const pct = Math.round(e.loaded / e.total * 100); pb.style.width = pct + '%'; pt.textContent = pct + '%'; } };
                xhr.onload = () => {
                    try {
                        const d = JSON.parse(xhr.responseText);
                        if (xhr.status === 200) { toast('🎉 Deployment started!', 'success'); document.getElementById('projName').value = ''; document.getElementById('ghUrl').value = ''; fi.value = ''; document.getElementById('fileLabel').innerHTML = 'Drop your project ZIP here or <span class="text-brand-purple">browse</span>'; setTimeout(() => fetchProjects(), 2000); }
                        else if (xhr.status === 401) { toast('Session expired', 'error'); doLogout(); }
                        else toast(d.msg || 'Failed', 'error');
                    } catch (err) { }
                    btn.disabled = false; btn.innerHTML = '🚀 Deploy Now';
                    setTimeout(() => { pw.classList.add('hidden'); pb.style.width = '0%'; }, 1500);
                };
                xhr.onerror = () => { toast('Connection error', 'error'); btn.disabled = false; btn.innerHTML = '🚀 Deploy Now'; pw.classList.add('hidden'); };
                xhr.send(fd);
            };
        }

        /* ── Fetch Projects ── */
        async function fetchProjects() {
            const tbody = document.getElementById('projBody'), tbl = document.getElementById('projTable'), empty = document.getElementById('emptyState'), load = document.getElementById('loadState');
            tbody.innerHTML = ''; tbl.style.display = 'table'; empty.style.display = 'none'; load.style.display = 'block';
            try {
                const r = await fetch(API + '/projects', { headers: { 'Authorization': 'Bearer ' + token } });
                if (r.status === 401) { toast('Session expired', 'error'); return doLogout(); }
                const projects = await r.json(); load.style.display = 'none';
                if (!Array.isArray(projects) || !projects.length) { tbl.style.display = 'none'; empty.style.display = 'block'; updateStats([]); return; }
                updateStats(projects); document.getElementById('projCount').textContent = projects.length + ' project' + (projects.length > 1 ? 's' : '');
                const colors = ['from-blue-500 to-cyan-400', 'from-purple-500 to-pink-400', 'from-emerald-500 to-teal-400', 'from-red-500 to-orange-400', 'from-amber-500 to-yellow-400'];
                projects.forEach((p, i) => {
                    const live = p.status === 'running' || p.status === 'live', fail = p.status === 'failed';
                    const sc = live ? 'bg-emerald-50 text-emerald-700' : fail ? 'bg-red-50 text-red-700' : 'bg-amber-50 text-amber-700';
                    const dc = live ? 'status-live' : fail ? 'status-failed' : 'status-deploying';
                    const st = live ? 'Live' : fail ? 'Failed' : 'Deploying';
                    const pid = p._id || p.id;
                    const purl = live ? `<a href="${p.url}" target="_blank" class="text-brand-purple hover:underline text-xs font-medium">${p.name}.devdeploy.app</a>` : fail ? '<span class="text-gray-400 text-xs italic">build error</span>' : '<span class="text-gray-400 text-xs italic">pending...</span>';
                    const tr = document.createElement('tr'); tr.className = 'border-b border-gray-50 fade-in';
                    tr.innerHTML = `<td class="px-5 py-3.5 font-semibold text-gray-900 flex items-center gap-2.5"><span class="w-7 h-7 rounded-lg bg-gradient-to-br ${colors[i % colors.length]} flex items-center justify-center text-[10px] text-white font-bold">${p.name[0].toUpperCase()}${i + 1}</span>${p.name}</td><td class="px-5 py-3.5"><span class="inline-flex items-center gap-1.5 px-2.5 py-1 ${sc} rounded-full text-xs font-semibold"><span class="status-dot ${dc}"></span>${st}</span></td><td class="px-5 py-3.5 hidden md:table-cell">${purl}</td><td class="px-5 py-3.5 text-right"><button onclick="deleteProject('${pid}',this)" class="w-7 h-7 rounded-lg bg-red-50 hover:bg-red-100 text-red-500 inline-flex items-center justify-center transition-colors" title="Delete"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg></button></td>`;
                    tbody.appendChild(tr);
                });
            } catch (e) { console.error(e); load.style.display = 'none'; toast('Failed to load projects', 'error'); }
        }
        function updateStats(p) { document.getElementById('statTotal').textContent = p.length; document.getElementById('statLive').textContent = p.filter(x => x.status === 'running' || x.status === 'live').length; document.getElementById('statBW').innerHTML = (p.length * .2).toFixed(1) + '<span class="text-sm font-medium text-gray-400"> GB</span>'; }

        /* ── DELETE ── */
        async function deleteProject(id, btn) {
            if (!confirm('Delete this project permanently?')) return;
            const orig = btn.innerHTML; btn.disabled = true; btn.innerHTML = '<span class="w-3 h-3 border-2 border-red-400 border-t-transparent rounded-full animate-spin inline-block"></span>';
            try {
                const r = await fetch(API + '/projects/' + id, { method: 'DELETE', headers: { 'Authorization': 'Bearer ' + token } });
                const d = await r.json();
                if (r.ok) { toast('✅ Project deleted', 'success'); const row = btn.closest('tr'); if (row) { row.style.opacity = '0'; row.style.transition = 'opacity .4s ease'; setTimeout(() => fetchProjects(), 400); } else { fetchProjects(); } }
                else if (r.status === 401) { toast('Session expired', 'error'); doLogout(); }
                else { toast(d.msg || 'Delete failed', 'error'); btn.disabled = false; btn.innerHTML = orig; }
            } catch (e) { console.error('[Delete]', e); toast('Connection error', 'error'); btn.disabled = false; btn.innerHTML = orig; }
        }

        /* ── Logout ── */
        function doLogout() { localStorage.removeItem('token'); localStorage.removeItem('username'); token = null; username = null; navigate('login'); }

        /* ── Toast ── */
        function toast(msg, type) { const t = document.getElementById('toast'); t.textContent = msg; t.className = 'show ' + (type === 'success' ? 'bg-emerald-600' : 'bg-red-600') + ' text-white shadow-xl'; setTimeout(() => t.className = '', 4000); }

        /* ── Auto-refresh deploying ── */
        setInterval(() => { if (document.getElementById('dashboardSection').style.display === 'block' && document.querySelector('.status-deploying')) fetchProjects(); }, 6000);

        /* ── Back/Forward buttons ── */
        window.onpopstate = (e) => { const h = location.hash.replace('#', ''); if (h) navigate(h, false); else navigate('landing', false); };

        init();
    </script>
</body>

</html>