PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/devdeploy
JWT_SECRET=change_this_to_a_strong_random_secret
HOST_IP=YOUR_EC2_ELASTIC_IP
NGINX_CONF_DIR=/etc/nginx/devdeploy-sites
WORK_DIR=/var/devdeploy/projects
GITHUB_WEBHOOK_SECRET=optional_github_webhook_secret
NODE_ENV=production
