# This is a template Dockerfile for deploying static HTML/CSS/JS sites.
# It is auto-generated by the DevDeploy deployment engine.

FROM nginx:alpine

# Remove default nginx static files
RUN rm -rf /usr/share/nginx/html/*

# Copy project files into nginx html dir
COPY . /usr/share/nginx/html

# Expose port 80
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
